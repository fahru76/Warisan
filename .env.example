# Public Supabase project URL
SUPABASE_URL=
# Public browser key
SUPABASE_ANON_KEY=
# Server-only values; never expose in browser code
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Browser (Vite) values: ONLY public keys may use the VITE_ prefix ---
# Same values as SUPABASE_URL / SUPABASE_ANON_KEY above. Leave blank to run on fixture data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Canonical origins used for provenance QR links and cross-domain navigation
VITE_ORG_ORIGIN=https://warisan.org
VITE_NET_ORIGIN=https://warisan.net
